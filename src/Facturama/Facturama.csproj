<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Facturama.Sdk</PackageId>
    <RootNamespace>Facturama</RootNamespace>
    <AssemblyName>Facturama</AssemblyName>
    <Description>Facturama SDK for .NET: thin client for the Facturama (Mexican CFDI invoicing) Web and Multi-issuer REST APIs.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
